# Copy to .env.local and fill in. Restart `pnpm dev` after editing.

# Generation API origin (server only). Higgsfield's platform API:
HF_API_BASE_URL=https://api.higgsfield.ai

# Vercel Blob read-write token. Only needed to upload start frames,
# references, video or audio; text-only prompts work without it.
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=
